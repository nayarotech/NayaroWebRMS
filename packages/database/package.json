{
  "name": "@nayaro/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and SQLite access for Nayaro RMS.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:migrate": "prisma migrate dev && npm run db:bundle-migrations",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:bundle-migrations": "node scripts/bundle-migrations.mjs",
    "db:studio": "prisma studio",
    "db:verify": "tsx scripts/verify-database.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "libsql": "0.5.29"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "tsx": "4.23.13"
  }
}
