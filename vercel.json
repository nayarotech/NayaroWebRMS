{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm ci --include=dev --workspaces --include-workspace-root",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/((?!@|.*\\.).*)", "destination": "/index.html" }]
    },
    "server": {
      "root": "packages/server",
      "framework": "express",
      "installCommand": "cd ../.. && npm ci --include=dev --workspaces --include-workspace-root",
      "entrypoint": "app.ts",
      "devCommand": "node --import tsx app.ts",
      "buildCommand": "npm run db:generate --workspace @nayaro/database && npm run typecheck"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "server" } },
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
