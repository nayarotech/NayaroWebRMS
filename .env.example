# Copy to .env and adjust. Never commit .env.

# --- API (packages/server) -------------------------------------------------
# Port and interface the API listens on.
PORT=4000
HOST=0.0.0.0

# Database: a file path, or a libSQL URL for a managed server
# (e.g. libsql://your-db.turso.io). Defaults to packages/server/.data/nayaro.db.
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=
# Vercel deployments require a managed libSQL DATABASE_URL (local files are ephemeral).

# Comma-separated browser origins allowed to call the API (required in production).
WEB_ORIGINS=http://localhost:5180

# Set when the API runs behind a reverse proxy, so rate limits and audit logs
# see the real client address: "1" trusts one hop, or name the proxy address.
# TRUST_PROXY=1

# NODE_ENV=production enables HSTS and requires WEB_ORIGINS.
# NODE_ENV=production

# Optional limits.
# API_RATE_LIMIT_PER_MINUTE=600
# REGISTRATIONS_PER_HOUR=5

# Password for every account created by `npm run demo:seed`.
# DEMO_PASSWORD=

# Email (restaurant sign-up verification codes), sent through Resend.
# Without a key, development prints codes to the API log; production refuses
# sign-ups with "email is not set up". The sending domain must be verified in Resend.
# RESEND_API_KEY=
# EMAIL_FROM=Nayaro RMS <noreply@nayaro.tech>

# --- Web application (apps/web) -------------------------------------------
# Public API path, baked into the build. Vercel and Vite dev proxy both use /api.
# This is a browser URL, never a runtime service binding.
VITE_API_URL=/api
# For a separately hosted API, set VITE_API_URL=https://api.example.com instead.
# Optional target for the local Vite proxy (never used for Vercel service discovery).
# DEV_API_URL=http://localhost:4000
